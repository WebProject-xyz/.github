{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "WebProject.xyz organisation renovate config",
  "platform": "github",
  "assignees": [
    "fahl-design"
  ],
  "extends": [
    ":dependencyDashboard",
    ":ignoreModulesAndTests",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    ":enableVulnerabilityAlerts",
    ":timezone(UTC)",
    ":label(renovate)",
    "group:allNonMajor",
    ":automergePr",
    ":automergeRequireAllStatusChecks",
    ":label(dependencies)",
    ":gitSignOff",
    ":semanticPrefixChore",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests"
  ],
  "rebaseWhen": "behind-base-branch",
  "automergeType": "pr",
  "commitBodyTable": true,
  "lockFileMaintenance": {
    "enabled": true,
    "extends": [
      "schedule:daily"
    ],
    "automerge": true,
    "assignees": []
  },
  "platformAutomerge": true,
  "prFooter": "[Read more information](https://github.com/WebProject-xyz/.github/blob/main/RENOVATE.md) about the use of [Renovate Bot](https://github.com/renovatebot/renovate).",
  "rangeStrategy": "replace",
  "rollbackPrs": true,
  "pinDigests": true,
  "minimumReleaseAge": "1 day",
  "composer": {
    "composerIgnorePlatformReqs": false
  },
  "constraints": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0"
  },
  "packageRules": [
    {
      "description": "General automerge for minor and patch updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Group all CI/infra updates (GitHub Actions + Docker digests) into one PR (no review required)",
      "matchManagers": [
        "github-actions",
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "ci-and-docker",
      "automerge": true,
      "assignees": []
    },
    {
      "description": "Group PHP development tools",
      "matchPackageNames": [
        "phpunit/**",
        "phpstan/**",
        "codeception/**"
      ],
      "groupName": "PHP Dev Tools"
    },
    {
      "description": "Symfony minor: widen range for forward compatibility and automerge without review",
      "matchPackageNames": [
        "symfony/**"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "groupSlug": "symfony",
      "groupName": "Symfony Packages",
      "rangeStrategy": "widen",
      "automerge": true,
      "assignees": []
    },
    {
      "description": "Symfony major: widen range, manual review required",
      "matchPackageNames": [
        "symfony/**"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupSlug": "symfony-major",
      "groupName": "Symfony Packages (major)",
      "rangeStrategy": "widen",
      "automerge": false,
      "extends": [
        ":label(Awaiting Maintainer Response)"
      ]
    },
    {
      "description": "Symfony patch updates: automerge without review",
      "matchPackageNames": [
        "symfony/**"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupSlug": "symfony-patch",
      "groupName": "Symfony Packages (patch)",
      "automerge": true,
      "assignees": []
    },
    {
      "description": "PHP runtime: manual review required (runtime constraint)",
      "matchDepNames": [
        "php"
      ],
      "allowedVersions": "~8.3.0 || ~8.4.0 || ~8.5.0",
      "automerge": false,
      "ignoreUnstable": false,
      "groupName": "PHP",
      "extends": [
        ":label(Awaiting Maintainer Response)"
      ]
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "versioning": "semver"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "extends": [
      ":automergeDisabled",
      ":automergePr",
      ":labels(security)"
    ],
    "rangeStrategy": "bump"
  }
}
